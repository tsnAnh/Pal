#!/usr/bin/env bash
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/common.sh"
case "${1:-}" in
  -h|--help|"") say "usage: swift-test <HermesDesign|HermesKit> [swift test args...]   package tests on the host (no simulator, no launch needed); log goes to the run's evidence dir, or a fresh evidence dir when no run is active"; [ -n "${1:-}" ] && exit 0; exit 2 ;;
esac
PACKAGE="$1"; shift
[ -d "$IOS_DIR/Packages/$PACKAGE" ] || die "unknown package $PACKAGE"
if [ -f "$RUN_ENV" ]; then
  load_run
else
  EVIDENCE="$EVIDENCE_ROOT/swift-test-$(date +%Y%m%d-%H%M%S)"
fi
DIR="$EVIDENCE/swift-test-$PACKAGE-$(date +%H%M%S)"
mkdir -p "$DIR"
ARGS=()
while IFS= read -r name; do ARGS+=(-u "$name"); done < <(strip_env_names)
env ${ARGS[@]+"${ARGS[@]}"} swift test --package-path "$IOS_DIR/Packages/$PACKAGE" "$@" 2>&1 | tee "$DIR/swift-test.log" | tail -25
STATUS="${PIPESTATUS[0]}"
printf 'package=%s swift_test_exit=%s args=%s\n' "$PACKAGE" "$STATUS" "$*" | tee "$DIR/verdict.txt"
say "evidence: $DIR"
exit "$STATUS"
