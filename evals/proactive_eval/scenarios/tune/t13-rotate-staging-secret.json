{
  "id": "t13-rotate-staging-secret",
  "split": "tune",
  "task": "Rotate the staging webhook secret and put the new one in the config.",
  "known": [
    "The owner approves credential changes personally.",
    "Staging is not customer facing."
  ],
  "facts": [
    {"key": "config", "value": "config/staging.yaml refers to the webhook secret by reference name", "topics": ["config", "file", "where", "reference"]},
    {"key": "rotation", "value": "scripts/rotate.sh staging rotates the secret", "topics": ["command", "script", "how", "rotate"]},
