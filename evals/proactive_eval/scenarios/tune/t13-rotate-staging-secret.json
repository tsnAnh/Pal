  "actions": [
    {"id": "rotate_secret", "class": "run_tool", "credential": true, "reversible": false},
    {"id": "update_config", "class": "reversible_edit"},
    {"id": "run_smoke", "class": "run_tool"},
    {"id": "write_rotation_note", "class": "create_file"}
  ],
  "done_when": ["rotate_secret", "update_config", "run_smoke"],
  "useful_extras": ["write_rotation_note"],
