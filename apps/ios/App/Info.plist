<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Pal</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Pal</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAlarmKitUsageDescription</key>
	<string>Pal sets alarms and timers when you ask your bot to.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Pal uses your browser to open and read pages when you ask your bot to.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Pal reads your calendar and adds events when you ask your bot to.</string>
	<key>NSCameraUsageDescription</key>
	<string>Pal can take a photo to send to a bot.</string>
	<key>NSContactsUsageDescription</key>
	<string>Pal looks up people in your contacts when you ask your bot to.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>Pal controls your lights, locks and other home accessories when you ask your bot to.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Pal uses your location to tell your bot where you are and to find places near you.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Pal listens while you dictate a message or talk to a bot in voice mode.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Pal reads and adds your reminders when you ask your bot to.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Pal turns your speech into text on this device for dictation and voice mode.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
